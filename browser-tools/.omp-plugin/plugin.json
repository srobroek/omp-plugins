{
  "name": "browser-tools",
  "description": "Cross-engine browser coverage and Chrome performance tracing over MCP.",
  "version": "0.2.0",
  "category": "development",
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ]
    },
    "playwright-cross-engine": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "webkit"
      ]
    }
  }
}
