name: Setup TypeScript
description: Install bun and the locked dependencies.

inputs:
  working-directory:
    description: >-
      Directory holding this member's package.json and lockfile. Set this per member in
      a monorepo; the default is the repository root.
    required: false
    default: "."

runs:
  using: composite
  steps:
    # setup-bun takes no path: it installs and caches the bun executable, nothing
    # read out of the repository. Only the install below is directory-sensitive, and a
    # composite action does not inherit the calling job's `defaults.run`.
    - uses: oven-sh/setup-bun@735343b667d3e6f658f44d0eca948eb6282f2b76 # v2.0.2
      with:
        # The same exact version `.mise/conf.d/ts.toml` pins, not `latest`: bun is the
        # package manager and the test runner, so a floating version changes what CI
        # resolves and what it executes with no diff in this repository.
        bun-version: "@@BUN_VERSION@@"

    - name: Install the locked dependencies
      shell: bash
      working-directory: ${{ inputs.working-directory }}
      run: bun install --frozen-lockfile
