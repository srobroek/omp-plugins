name: Lint Go

on:
  workflow_call:
    inputs:
      working-directory:
        description: Directory to run in. Set this per member in a monorepo.
        required: false
        type: string
        default: "."

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    # GitHub defaults to 360 minutes, so a hung job burns six runner hours.
    timeout-minutes: 15
    defaults:
      run:
        working-directory: ${{ inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config, where any later step
          # can read it. zizmor reports the default as a finding.
          persist-credentials: false

      - uses: ./.github/actions/setup-go
        with:
          working-directory: ${{ inputs.working-directory }}

      - name: Format
        run: test -z "$(gofmt -l .)" || { gofmt -l .; exit 1; }

      - name: Lint
        uses: golangci/golangci-lint-action@0a35821d5c230e903fcfe077583637dea1b27b47 # v9.0.0
        with:
          # The exact version `.mise/conf.d/go.toml` pins, carrying the `v` prefix this
          # action's `version` input requires. Under `latest` a new release adds linters
          # and changes their findings, so CI and a local `just go-lint` disagree and the
          # gate moves with no diff in this repository.
          version: v@@GOLANGCI_LINT_VERSION@@
          working-directory: ${{ inputs.working-directory }}

      - name: Tidy
        run: go mod tidy -diff

      - name: Vulnerabilities
        # The exact version `.mise/conf.d/go.toml` pins. `@latest` resolves against the
        # proxy at the moment the job runs, so the vulnerability database query and its
        # exit status come from a binary nobody chose.
        run: |
          go install golang.org/x/vuln/cmd/govulncheck@v@@GOVULNCHECK_VERSION@@
          govulncheck ./...
