name: Setup Rust
description: Install the pinned toolchain and cargo tools, and warm the cargo cache.

inputs:
  working-directory:
    description: >-
      Directory holding this member's rust-toolchain.toml and Cargo.toml. Set this per
      member in a monorepo; the default is the repository root.
    required: false
    default: "."

runs:
  using: composite
  steps:
    # A composite action does not inherit the calling job's `defaults.run`, and a
    # `uses:` step has no working directory at all, so every path below is resolved
    # to an absolute one here rather than left for the nested action to guess.
    - name: Resolve the working directory
      id: dir
      shell: bash
      # Read through the environment: interpolating an input into the script body is
      # the template-injection finding zizmor reports.
      env:
        INPUT_DIR: ${{ inputs.working-directory }}
      run: |
        set -euo pipefail
        case "/$INPUT_DIR/" in
          //* | */../*)
            echo "working-directory must be a relative path inside the repository, got: $INPUT_DIR" >&2
            exit 1
            ;;
        esac
        cd -- "$INPUT_DIR"
        echo "path=$PWD" >> "$GITHUB_OUTPUT"

    - name: Install the toolchain from rust-toolchain.toml
      shell: bash
      working-directory: ${{ inputs.working-directory }}
      run: rustup show active-toolchain || rustup toolchain install

    - uses: Swatinem/rust-cache@98c8021b550208e191a6a3145459bfc9fb29c4c0 # v2.8.0
      with:
        # rust-cache reads the Cargo workspace named here, not the caller's working
        # directory, so a member's lockfile and target directory need naming.
        workspaces: ${{ steps.dir.outputs.path }}
        # The cargo tools below are pinned by version token; this cache is keyed on the
        # lockfile, which does not name them. Caching ${CARGO_HOME}/bin would serve a
        # previously pinned binary after the token moved, so the versions actually
        # executed would stop matching the ones this repository declares.
        cache-bin: false
        save-if: ${{ github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}

    # The exact versions `.mise/conf.d/rust.toml` pins, so a local run and a CI run
    # execute one build of each tool. Built here rather than written inline below because
    # install-action separates a tool from its version with `@`, which would leave a
    # version token butted against that separator and reading as a typo; each token
    # stays a standalone value instead.
    - name: Resolve the pinned cargo tool versions
      id: tools
      shell: bash
      env:
        NEXTEST: "@@CARGO_NEXTEST_VERSION@@"
        DENY: "@@CARGO_DENY_VERSION@@"
        MACHETE: "@@CARGO_MACHETE_VERSION@@"
        LLVM_COV: "@@CARGO_LLVM_COV_VERSION@@"
      run: |
        set -euo pipefail
        printf 'list=cargo-nextest@%s,cargo-deny@%s,cargo-machete@%s,cargo-llvm-cov@%s\n' \
          "$NEXTEST" "$DENY" "$MACHETE" "$LLVM_COV" >> "$GITHUB_OUTPUT"

    # A clean runner has none of these, and every caller of this action invokes at least
    # one: cargo-machete and cargo-deny in the lint workflow, cargo-nextest in the test
    # workflow, cargo-llvm-cov wherever coverage runs. Installed here rather than per
    # workflow so one list stays authoritative.
    #
    # install-action downloads the checksummed release binary for the exact version named.
    # `cargo install <tool>` would compile all four from source on every runner and, with
    # no `--version`, is the floating install this pin exists to remove.
    - uses: taiki-e/install-action@94c31af3204a9f15ab40b35ad084410b905bbc73 # v2.87.17
      with:
        tool: ${{ steps.tools.outputs.list }}
