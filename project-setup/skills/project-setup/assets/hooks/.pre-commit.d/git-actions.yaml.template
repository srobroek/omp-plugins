# .pre-commit.d/git-actions.yaml -- the agentic hooks that have a git event to attach to.
#
# Three agentic-packages hooks act on git actions. As PreToolUse hooks they fire only for an
# agent whose harness is configured; as prek entries committed to the repository they fire for
# every committer, and they survive an agent running without that config.
#
# What did NOT migrate, and why:
#
#   hooks-quality           PostToolUse on an edit; there is no git event for an edit
#   hooks-bash-safety       guards arbitrary shell, which git never sees
#   hooks-worktree          no git event
#   hooks-worktrunk         no git event
#   git reset --hard        a PRE-execution guard; a git hook runs after the decision
#   git clean -fd           the same
#   git checkout --         the same
#
# Only the force-push guard among the git-safety set has an event, and pre-push is it.
repos:
  - repo: local
    hooks:
      # `Closes #1, #2, #3` closes only #1: GitHub binds a closing keyword to the first issue
      # in a list. This rewrites the message IN PLACE at commit-msg so the rest close too.
      - id: normalize-close-keywords
        name: normalize GitHub close keywords
        entry: scripts/commit-msg-rewrite.py
        language: script
        stages: [commit-msg]
        always_run: true
        groups: [quality]

      # Advisory, and prints rather than blocking: the message is trivially fixable and a
      # denied commit costs more than a nudge. The enforcing copy is the `commits` job in the
      # quality workflow, which reads the whole pull request range.
      - id: attribution-guard
        name: no AI attribution in the commit message
        entry: python3 scripts/attribution_guard.py
        language: system
        stages: [commit-msg]
        always_run: true
        groups: [quality]

      # A force push to a shared branch discards commits CI already checked and that someone
      # may have pulled. pre-push is the only git event that sees the attempt.
      #
      # The branch is an argument rather than an ambient variable: the script protects exactly
      # what is passed here, so a repository whose default branch is not `main` is protected by
      # the same wiring instead of silently unprotected.
      - id: no-force-push-to-default
        name: refuse a force push to @@DEFAULT_BRANCH@@
        entry: scripts/no_force_push.sh
        args: ["@@DEFAULT_BRANCH@@"]
        language: script
        stages: [pre-push]
        always_run: true
        pass_filenames: false
        groups: [security]
