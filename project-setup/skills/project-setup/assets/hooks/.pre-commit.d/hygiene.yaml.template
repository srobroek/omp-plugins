# .pre-commit.d/hygiene.yaml -- the repo-wide checks.
#
# Folded into .pre-commit-config.yaml by `just hooks-merge`. Every language fragment
# sits beside this one, so a language's hooks travel with its layer rather than being
# listed here.
#
# What runs here is what is fast enough for every commit against staged files.
# Measured on a 212-file repository: actionlint 44-154ms, zizmor offline 54ms,
# lychee offline 64ms, taplo 399ms. The slow ones (cspell 1.7s, markdownlint 1.2s,
# yamllint 1.1s, pinact 1.4s over the network) run in the quality workflow instead.
#
# Groups let a caller run a subset: `prek run --group security`. Verified against
# prek 0.4.11.
# OPTIONAL BEGIN excluded paths -- delete both lines when nothing is excluded
exclude: "@@HOOK_EXCLUDE_PATTERNS@@"
# OPTIONAL END
repos:
  # prek implements these natively as `repo: builtin`: no clone, no rev to pin,
  # and they work offline. pre-commit rejects `repo: builtin` with "Missing
  # required key: rev", so this file requires prek, which is the fixed manager.
  - repo: builtin
    hooks:
      - {id: trailing-whitespace, groups: [hygiene]}
      - {id: end-of-file-fixer, groups: [hygiene]}
      - {id: check-yaml, groups: [hygiene]}
      - {id: check-toml, groups: [hygiene]}
      - {id: check-merge-conflict, groups: [hygiene]}
      - {id: check-added-large-files, args: ["--maxkb=@@MAX_FILE_KB@@"], groups: [hygiene]}
      - {id: mixed-line-ending, groups: [hygiene]}
      - {id: detect-private-key, groups: [security]}

  - repo: https://github.com/betterleaks/betterleaks
    rev: v1.7.1
    hooks:
      - id: betterleaks-system
        groups: [security]

  - repo: https://github.com/crate-ci/typos
    rev: v1.48.0
    hooks:
      - id: typos
        groups: [docs]

  - repo: https://github.com/shellcheck-py/shellcheck-py
    rev: v0.11.0.1
    hooks:
      - id: shellcheck
        groups: [quality]

  # Conventional Commits, replacing a hand-written 74-line script. `--strict`
  # rejects a `fixup!` or merge subject, and the release tooling reads these
  # subjects to compute the next version.
  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v4.4.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]
        groups: [quality]
        # --force-scope only makes sense alongside an allowlist; without one it
        # demands a scope while accepting any spelling of it. Keep exactly one of
        # the two `args:` lines below.
        # OPTIONAL BEGIN scope allowlist -- delete both lines when scopes stay unrestricted
        args: ["--strict", "--force-scope", "--scopes", "@@COMMIT_SCOPES@@"]
        # OPTIONAL END
        # OPTIONAL BEGIN no scope allowlist -- delete both lines when scopes are restricted
        args: ["--strict"]
        # OPTIONAL END

  - repo: local
    hooks:
      # Verifies a candidate credential against the issuing API, so it reports
      # live keys the regex scanners rate too low-entropy to flag. The regex scan
      # above reads the index; this reads the working tree against HEAD.
      - id: trufflehog
        name: trufflehog (verified secrets)
        entry: trufflehog git file://. --since-commit HEAD --results=verified --fail --no-update
        language: system
        pass_filenames: false
        groups: [security]

      - id: actionlint
        name: actionlint
        entry: actionlint
        language: system
        files: ^\.github/workflows/.*\.ya?ml$
        groups: [quality]

      # zizmor audits for the credential and injection patterns actionlint does
      # not model. Offline here: its network audits need a token, and CI runs it
      # again with one.
      - id: zizmor
        name: zizmor (workflow security)
        entry: zizmor --offline --persona regular
        language: system
        files: ^\.github/workflows/.*\.ya?ml$
        groups: [security]

      - id: taplo
        name: taplo lint
        entry: taplo lint
        language: system
        types: [toml]
        groups: [quality]

      # Offline only: it resolves relative links and skips network URLs, so a
      # commit never waits on HTTP. CI runs lychee without --offline.
      - id: lychee
        name: lychee (offline link check)
        entry: lychee --offline --no-progress
        language: system
        types: [markdown]
        groups: [docs]
