name: Release

# The one branch release-please reads. A repository whose default branch is not `main` gets
# no release pull request at all when this list names the wrong one, and nothing fails to
# say so: the workflow simply never triggers.
on:
  push:
    branches: ["@@DEFAULT_BRANCH@@"]

permissions:
  contents: write
  pull-requests: write

jobs:
  release-please:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: googleapis/release-please-action@0dfd8538845b8e92600d271a895a5372865d4062 # v5
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          config-file: release-please-config.json
