# Rendered accessibility checks.

# Install the committed accessibility tool package
[group('a11y')]
a11y-deps:
    cd .a11y && bun install --frozen-lockfile

# Prepare every product member whose server the scan starts
[group('a11y')]
a11y-prepare:
    #!/usr/bin/env bash
    set -euo pipefail
@@A11Y_PREPARE_COMMANDS@@

# Install the Chromium runtime used by Playwright
[group('a11y')]
a11y-install:
    #!/usr/bin/env bash
    set -euo pipefail
    cd .a11y
    if [ "${CI:-}" = "true" ] || [ "$(uname -s)" = "Linux" ]; then
      bunx playwright install --with-deps chromium
    else
      bunx playwright install chromium
    fi

# Run axe against accepted routes
[group('a11y')]
a11y:
    cd .a11y && bunx playwright test --config playwright.config.ts
