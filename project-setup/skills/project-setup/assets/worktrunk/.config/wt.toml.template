# Worktrunk project configuration. Committed, so it is shared.
#
# A project-defined command is gated: worktrunk lists it and asks once, then
# remembers the answer in ~/.config/worktrunk/approvals.toml. Editing a command
# invalidates its approval, so a change here prompts again.
#
# User hooks run before project hooks and need no approval. Keep per-developer
# choices, such as which agent CLI writes commit messages, in user config.

# Blocking. A failure cancels the merge, which is the point: this is the same
# gate CI runs, so a merge cannot land what CI would reject.
pre-merge = "just check"

[[pre-start]]
# Trust before anything reads the config: an untrusted mise config is skipped
# silently, so without this `mise install` reports success having read nothing.
# Also in many user configs, and running it twice is free -- carrying it here is
# what makes a fresh contributor's first worktree work without per-user setup.
trust = "mise trust --yes"

[[pre-start]]
# Copy ignored files before installing anything that depends on them.
copy-ignored = "wt step copy-ignored --require-include"

[[pre-start]]
# mise supplies the interpreter and toolchain the dependency and hook steps need.
toolchain = "mise install --yes"

[[pre-start]]
# Blocking, so `--execute` and post-start see a usable tree. A copied cache from
# copy-ignored makes this fast; without one it is a cold install.
#
# `just setup` installs the hook shims with `prek install --git-dir`, resolved per
# checkout. A linked worktree's $GIT_DIR is `.git/worktrees/<name>/`, which is where git
# looks for its hooks, so shims in the primary would never fire here. Running setup per
# worktree start means each one hooks itself, and a clone that never ran setup by hand
# still gets hooked.
deps = "@@SETUP_COMMAND@@"

[forge]
platform = "@@FORGE_PLATFORM@@"
# OPTIONAL BEGIN self-hosted forge -- delete all three lines when the forge is the platform's public host
hostname = "@@FORGE_HOSTNAME@@"
# OPTIONAL END

[commit.generation]
# Appended to the commit and squash prompts inside a <project-guidance> block.
# Only template-append is honoured from a project file; the command and the main
# template stay in user config, since they describe the developer's environment.
template-append = """
- Conventional commit subjects: the changelog is generated from them.
- State what the change does, not what it was before.
- No authorship attribution, and no agent name in the message.
"""

[step.copy-ignored]
# Combined with the user config's excludes, and an exclude beats an include:
# verified by listing `target/` in both, where nothing copied. So a path listed
# here can never be recovered by a `.worktreeinclude`, in this repository or
# anyone's.
#
# Caches belong in `.worktreeinclude`, not here: copying one is the whole point.
# What stays out is state that must not be forked.
exclude = [
  # A Dolt database with its own sync protocol on refs/dolt/data. A copy would
  # diverge from the branch it was taken from rather than share it.
  ".beads/dolt/",
]

[post-start]
# OPTIONAL BEGIN dev server -- delete through the next OPTIONAL END when the project serves nothing
# Tethered, so the process tree dies with the worktree rather than holding the
# port after `wt merge` removes it. This applies only when the project serves.
dev = "wt step tether -- env PORT={{ branch | hash_port }} @@DEV_COMMAND@@"

[list]
# hash_port maps a branch to 10000-19999, stable for a given branch, so two
# worktrees never contend for one port. Dimmed in `wt list` when nothing listens.
url = "http://localhost:{{ branch | hash_port }}"
# OPTIONAL END
