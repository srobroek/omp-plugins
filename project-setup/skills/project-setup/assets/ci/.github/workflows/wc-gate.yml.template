name: Gate

# The one required status check. Every other job reaches it through the caller's
# `needs:`, so a new job is covered by the gate without touching branch
# protection, and a failure names which job failed.

on:
  workflow_call:
    inputs:
      needs:
        description: The caller's needs context, passed as toJSON(needs).
        required: true
        type: string

permissions:
  contents: read

jobs:
  gate:
    name: Required gate
    runs-on: ubuntu-latest
    # GitHub defaults to 360 minutes, so a hung job burns six runner hours.
    timeout-minutes: @@JOB_TIMEOUT_MINUTES@@
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config, where any later step
          # can read it. zizmor reports the default as a finding.
          persist-credentials: false

      - uses: ./.github/actions/ci-gate
        with:
          needs: ${{ inputs.needs }}
