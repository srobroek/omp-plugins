# justfile -- the task surface. Run `just` to list every task.
#
# Tasks live in .just.d/, one fragment per layer, imported below. A language's
# tasks travel with its layer, so this file names no language.
#
# Add a project-specific task with `just just-add <name>`, which writes a new
# fragment. Editing this file directly works too, outside the generated block.

# macOS ships bash 3.2, where `mapfile` and `readarray` do not exist. A task
# using either reports success while doing nothing.
set shell := ["bash", "-uc"]

# Show every task, grouped
default:
    @just --list

# BEGIN GENERATED: imports
# One line per .just.d fragment, rebuilt by `just just-sync`. Do not edit by hand.
#
# `import?` rather than `import`: the optional form. A missing file under the hard
# form is a parse error that takes down every task in the justfile, so a fragment
# removed by hand would break `just` entirely rather than just its own tasks.
# No fragments rendered yet.
# END GENERATED: imports

# --- setup -----------------------------------------------------------------
#
# What a fresh clone runs, and what Worktrunk's blocking pre-start runs per worktree.
# Worktrunk owns copy-ignored; setup orders trust, copy, toolchain, then dependencies.
# Every step probes for the task that does the work, because which layers rendered
# decides which exist: a dependency on one that never rendered is a parse error that
# breaks every task in this file.
#
# Ordered by what the next step needs. Trust and copy come first; toolchain precedes
# dependency tasks.
#
# `setup` is for a fresh clone. `setup-worktree` is what `wt`'s blocking pre-start runs,
# and it is deliberately the shorter list: `.worktreeinclude` copies `.venv` and
# `node_modules` from the primary, so a worktree refreshes them rather than installing cold.

# Install the toolchain, the dependencies, and the hook shims
[group('all')]
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v mise >/dev/null 2>&1; then
      echo "==> toolchain"
      # Trust first: without it mise may skip the config or fail unable to prompt, and
      # then `mise install` reads nothing and reports success.
      mise trust --yes
      mise install --yes
    else
      echo "mise is not on PATH; skipping the toolchain" >&2
    fi

    for task in $(just --summary 2>/dev/null | tr ' ' '\n' | grep -E '^(rust|python|go|ts)-install$' || true); do
      echo "==> $task"
      just "$task"
    done

    for task in hooks-install; do
      if just --show "$task" >/dev/null 2>&1; then
        echo "==> $task"
        just "$task"
      fi
    done

# What a copy cannot provide, plus a dependency refresh in case this branch moved a
# lockfile. Measured warm: uv sync 43ms, cargo fetch 0.55s, go mod download 15ms, so the
# refresh is close to free and a stale copied tree is the thing it prevents.
#
#   mise trust      a new directory is untrusted, and an untrusted config is skipped
#   hooks-install   a worktree's $GIT_DIR is `.git/worktrees/<name>/`, which is where git
#                   looks for its hooks, so shims in the primary never fire here

# Prepare a linked worktree, after copy-ignored has warmed the caches
[group('all')]
setup-worktree:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v mise >/dev/null 2>&1; then
      mise trust --yes
    fi
    for task in $(just --summary 2>/dev/null | tr ' ' '\n' | grep -E '^(rust|python|go|ts)-install$' || true); do
      echo "==> $task"
      just "$task"
    done

    for task in hooks-install; do
      if just --show "$task" >/dev/null 2>&1; then
        echo "==> $task"
        just "$task"
      fi
    done

# --- aggregates ------------------------------------------------------------
#
# These dispatch to whichever per-language tasks exist rather than naming them.
# `just --show <name>` exits non-zero for a task that was never imported, so a
# repository with one language runs one, and adding a language layer needs no edit
# here.

# `hooks-all` is probed rather than declared as a dependency. A dependency on a
# task no fragment provided is a parse error that breaks every task in the
# file, and quality/hooks may not have rendered.
#
# The comment directly above a task becomes its `--list` description, so the
# rationale goes here and the description stays on the last line.

# Format, lint, type-check, and test every language present
[group('all')]
check:
    #!/usr/bin/env bash
    set -euo pipefail
    if just --show hooks-all >/dev/null 2>&1; then
      echo "==> hooks"
      just hooks-all
    fi
    ran=0
    for name in rust python go ts api; do
      if just --show "$name" >/dev/null 2>&1; then
        echo "==> $name"
        just "$name"
        ran=1
      fi
    done
    if [ "$ran" = 0 ]; then
      echo "no language tasks found; nothing to check" >&2
    fi

# Run one phase across every language: fmt, lint, test, types, or cov
[group('all')]
each phase:
    #!/usr/bin/env bash
    set -euo pipefail
    ran=0
    for name in rust python go ts; do
      task="$name-{{ phase }}"
      if just --show "$task" >/dev/null 2>&1; then
        echo "==> $task"
        just "$task"
        ran=1
      fi
    done
    if [ "$ran" = 0 ]; then
      echo "no task matches *-{{ phase }}" >&2
      exit 1
    fi

# --- the task surface itself -----------------------------------------------

# Rebuild the import block from .just.d/
[group('just')]
just-sync:
    @python3 scripts/gen_justfile.py .

# Start a new fragment for project-specific tasks
[group('just')]
just-add name:
    #!/usr/bin/env bash
    set -euo pipefail
    target=".just.d/{{ name }}.just"
    if [ -e "$target" ]; then
      echo "$target already exists" >&2
      exit 1
    fi
    mkdir -p .just.d
    cat > "$target" <<EOF
    # {{ name }} tasks, imported by the root justfile.

    [group('{{ name }}')]
    {{ name }}-example:
        @echo "replace me"
    EOF
    just just-sync
    echo "wrote $target"

# Checked in a copy: a check that rewrites the file it is checking leaves a dirty
# tree in CI, and the second run passes because the first one fixed it.

# Fail when the import block is stale
[group('just')]
just-check:
    #!/usr/bin/env bash
    set -euo pipefail
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' EXIT
    cp justfile "$scratch/justfile"
    ln -s "$PWD/.just.d" "$scratch/.just.d" 2>/dev/null || true
    python3 scripts/gen_justfile.py "$scratch" >/dev/null
    if ! diff -q justfile "$scratch/justfile" >/dev/null; then
      echo "justfile imports are stale; run 'just just-sync'" >&2
      diff justfile "$scratch/justfile" || true
      exit 1
    fi
