name: Lint API

# Both jobs are contract checks, so they sit in one workflow rather than the lint/test
# pair a language layer contributes.

on:
  workflow_call:
    inputs:
      working-directory:
        description: Directory containing this member's API contract.
        required: false
        type: string
        default: "."
      baseline-ref:
        description: >-
          Ref the breaking-change check compares against on a push, or when a caller names
          its own. A pull request resolves the branch it targets and ignores this.
        required: false
        type: string
        default: "@@API_BASELINE_REF@@"

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    defaults:
      run:
        working-directory: ${{ inputs.working-directory }}
    runs-on: ubuntu-latest
    timeout-minutes: @@JOB_TIMEOUT_MINUTES@@
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config, where any later step can
          # read it. zizmor reports the default as a finding.
          persist-credentials: false

      - name: Install tools
        uses: jdx/mise-action@9e7f7633ff6f6d6048a9418a68d48f288f50eb14 # v4.2.3
        with:
          cache: true

      - name: Lint the contract
        run: just api-lint

  breaking:
    name: Breaking changes
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ${{ inputs.working-directory }}
    timeout-minutes: @@JOB_TIMEOUT_MINUTES@@
    # API_BASELINE is the one name both CI systems export and `just api-breaking` reads. It
    # is resolved here rather than taken from the caller, because a pull request is measured
    # against the branch it targets and the ref planned at setup is the wrong one for a pull
    # request opened against any other branch.
    env:
      API_BASELINE: >-
        ${{ github.event_name == 'pull_request'
        && format('origin/{0}', github.event.pull_request.base.ref)
        || inputs.baseline-ref }}
    steps:
      # The full history, not a shallow clone: the check reads the spec out of the
      # baseline ref, and a depth-1 fetch has no such object.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Install tools
        uses: jdx/mise-action@9e7f7633ff6f6d6048a9418a68d48f288f50eb14 # v4.2.3
        with:
          cache: true

      # `just api-breaking` passes --fail-on ERR, which is what makes this gate: oasdiff
      # prints every breaking change and exits 0 without it.
      - name: Fail on a breaking change
        run: just api-breaking

      # Posted rather than only logged, so a reviewer sees the contract delta beside the
      # diff that caused it. It reads the same API_BASELINE, or the summary would describe a
      # different comparison from the one that passed or failed.
      - name: Summarise the changes
        if: always()
        run: |
          {
            echo "### API contract changes"
            echo
            echo '```'
            just api-diff 2>&1 || echo "no baseline to compare against"
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
