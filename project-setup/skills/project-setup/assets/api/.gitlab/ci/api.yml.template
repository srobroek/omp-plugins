# .gitlab/ci/api.yml -- resolved by `include: - local: .gitlab/ci/*.yml`. Every key is
# prefixed `api`, because merge order across the glob is not deterministic.
.api-setup:
  image: debian:stable-slim
  before_script:
    - apt-get update -qq && apt-get install -yqq curl git
    - curl -sSf https://mise.run | sh
    - export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
    - mise install --yes
    - eval "$(mise activate bash --shims)"

api-lint:
  extends: .api-setup
  stage: lint
  script:
    - just api-lint

api-breaking:
  extends: .api-setup
  stage: lint
  # The default GIT_DEPTH of 50 can miss the merge base on a long-lived branch, and the
  # check reads the spec out of that ref.
  variables:
    GIT_DEPTH: "0"
  script:
    - just api-breaking
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
      variables:
        API_BASELINE: origin/$CI_MERGE_REQUEST_TARGET_BRANCH_NAME
    - if: $CI_COMMIT_BRANCH == "@@DEFAULT_BRANCH@@"
