# macOS
.DS_Store

# Python bytecode from scripts/
__pycache__/
*.py[cod]

# Editor and tool state
.vscode/
.idea/
*.swp

# OMP and Claude plugin install state, written when this repo is added as a
# local marketplace source during testing
omp-plugins.lock.json
installed_plugins.json
node_modules/

# Beads / Dolt runtime state. The per-directory .beads/.gitignore owns which
# files inside .beads/ are runtime; a blanket .beads/ here would also untrack
# config.yaml, which pins storage mode for every checkout.
.dolt/
*.db
.beads-credential-key

# Playwright MCP artifacts
.playwright-mcp/

# OMP project-scope plugin registry (machine-local paths)
.omp/plugins/
