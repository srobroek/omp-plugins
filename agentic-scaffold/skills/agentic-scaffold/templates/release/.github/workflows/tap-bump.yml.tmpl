name: Bump package taps

# After a release publishes, update the Homebrew cask and the Scoop manifest to the new version
# and asset digests, and open a pull request in each tap repository. The same release App
# identity that release-please uses signs the pull requests; no personal token is involved.
on:
  release:
    types: [published]

permissions: {}

env:
  ACTIONS_CACHE_MODE: none

jobs:
  bump:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include:
          - tap: homebrew-tap
            path: Casks/${name}.rb
            asset_pattern: aarch64.dmg
          - tap: scoop-bucket
            path: bucket/${name}.json
            asset_pattern: x64-setup.exe
    steps:
      - name: Read the release asset digest
        id: release
        env:
          GH_TOKEN: $${{ github.token }}
          TAG: $${{ github.event.release.tag_name }}
          PATTERN: $${{ matrix.asset_pattern }}
        run: |
          set -euo pipefail
          release_json="$$(gh release view "$$TAG" --repo "$$GITHUB_REPOSITORY" --json assets)"
          asset="$$(jq -r --arg p "$$PATTERN" '[.assets[]|select(.name|endswith($$p))][0]' <<<"$$release_json")"
          if [ "$$asset" = "null" ]; then
            echo "::warning::no asset ending in $$PATTERN on $$TAG; nothing to bump"
            echo "found=false" >> "$$GITHUB_OUTPUT"
            exit 0
          fi
          {
            echo "found=true"
            echo "version=$${TAG#v}"
            echo "url=$$(jq -r .url <<<"$$asset")"
            echo "sha256=$$(jq -r '.digest|sub("^sha256:"; "")' <<<"$$asset")"
          } >> "$$GITHUB_OUTPUT"
      - name: Mint an App token for the tap repository
        if: steps.release.outputs.found == 'true'
        id: app-token
        uses: actions/create-github-app-token@29824e69f54612133e76f7eaac726eef6c875baf # v2.2.1
        with:
          app-id: $${{ vars.RELEASE_APP_CLIENT_ID }}
          private-key: $${{ secrets.RELEASE_APP_PRIVATE_KEY }}
          owner: $${{ github.repository_owner }}
          repositories: $${{ matrix.tap }}
      - name: Check out the tap repository
        if: steps.release.outputs.found == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: $${{ github.repository_owner }}/$${{ matrix.tap }}
          token: $${{ steps.app-token.outputs.token }}
          path: tap
          persist-credentials: true
      - name: Update the manifest
        if: steps.release.outputs.found == 'true'
        id: update
        working-directory: tap
        env:
          MANIFEST: $${{ matrix.path }}
          VERSION: $${{ steps.release.outputs.version }}
          SHA256: $${{ steps.release.outputs.sha256 }}
          URL: $${{ steps.release.outputs.url }}
        run: |
          set -euo pipefail
          case "$$MANIFEST" in
            *.rb)
              sed -i -E "s/^(  version \").*(\")$$/\1$${VERSION}\2/" "$$MANIFEST"
              sed -i -E "s/^(  sha256 \").*(\")$$/\1$${SHA256}\2/" "$$MANIFEST"
              ;;
            *.json)
              jq --arg v "$$VERSION" --arg u "$$URL" --arg h "$$SHA256" '.version = $$v | .architecture."64bit".url = $$u | .architecture."64bit".hash = $$h' "$$MANIFEST" > manifest.tmp
              mv manifest.tmp "$$MANIFEST"
              ;;
          esac
          if git diff --quiet; then echo "changed=false" >> "$$GITHUB_OUTPUT"; else echo "changed=true" >> "$$GITHUB_OUTPUT"; fi
      - name: Open the bump pull request
        if: steps.release.outputs.found == 'true' && steps.update.outputs.changed == 'true'
        working-directory: tap
        env:
          GH_TOKEN: $${{ steps.app-token.outputs.token }}
          VERSION: $${{ steps.release.outputs.version }}
          TAP: $${{ github.repository_owner }}/$${{ matrix.tap }}
          MANIFEST: $${{ matrix.path }}
        run: |
          set -euo pipefail
          branch="bump-${name}-$${VERSION}"
          git config user.name "release-bot[bot]"
          git config user.email "release-bot[bot]@users.noreply.github.com"
          git checkout -b "$$branch"
          git add "$$MANIFEST"
          git commit -m "chore: bump ${name} to $${VERSION}"
          git push -u origin "$$branch"
          gh pr create --repo "$$TAP" --title "chore: bump ${name} to $${VERSION}" --body "Automated bump from $${GITHUB_REPOSITORY} release v$${VERSION}."
