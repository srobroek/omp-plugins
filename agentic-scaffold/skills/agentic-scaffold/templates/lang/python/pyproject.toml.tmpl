[project]
name = "${package_kebab}"
version = "0.1.0"
description = "${description}"
readme = "README.md"
requires-python = ">=3.12"
${authors}license = "${license_spdx}"
dependencies = []

[project.scripts]
${package_kebab} = "${package}:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[dependency-groups]
dev = ["pytest", "ruff", "pyright"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.pyright]
typeCheckingMode = "standard"

[tool.pytest.ini_options]
testpaths = ["tests"]
