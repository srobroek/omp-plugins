repos:
  - repo: local
    hooks:
      - id: biome
        name: biome
        entry: bunx biome check --write --no-errors-on-unmatched
        language: system
        types_or: [ts, tsx, javascript, jsx, json, css]
      - id: oxlint
        name: oxlint
        entry: bunx oxlint
        language: system
        types_or: [ts, tsx, javascript, jsx]
        pass_filenames: false
