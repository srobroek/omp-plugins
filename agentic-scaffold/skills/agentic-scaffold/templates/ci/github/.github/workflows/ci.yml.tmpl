name: CI

on:
  pull_request:
  push:
    branches: [main]
  merge_group:

permissions: {}

# Cancel superseded pull-request runs; never cancel main or merge-group runs.
concurrency:
  group: $${{ github.workflow }}-$${{ github.event.pull_request.number || github.sha }}
  cancel-in-progress: $${{ github.event_name == 'pull_request' }}

jobs:
${ci_jobs}
