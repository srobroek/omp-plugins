{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srobroek/omp-plugins/cad/skills/cad-concept/assets/schemas/handoff.schema.json",
  "title": "CAD concept handoff (L0 CONCEPT to L1 LAYOUT)",
  "description": "The chosen concept variant flattened for CAD: stable node ids and hierarchy, rough envelopes, authored transforms, joints with limits, and the variant parameters. Written by scripts/concept.py handoff. Z is up, lengths are mm, rotations are XYZ Euler degrees.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "units", "scene", "variant", "nodes", "joints", "alternatives"],
  "properties": {
    "format": { "const": "cad.concept-handoff" },
    "version": { "const": 1 },
    "units": { "const": "mm" },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "file", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1, "description": "Scene file name the handoff was exported from." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Digest of the exact scene bytes exported." }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "description": "Depth-first, parents before children. The first node is the variant root.",
      "items": { "$ref": "#/$defs/node" }
    },
    "joints": {
      "type": "array",
      "items": { "$ref": "#/$defs/joint" }
    },
    "alternatives": {
      "type": "array",
      "description": "Every other variant and its fate, for the decision record.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "disposition"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["not-chosen", "dropped", "merged"] },
          "into": { "$ref": "#/$defs/id" },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Axis-aligned bounds of the node and its subtree in the node's own frame, with every joint at its nominal value.",
      "required": ["min", "max", "size"],
      "properties": {
        "min": { "$ref": "#/$defs/vec3" },
        "max": { "$ref": "#/$defs/vec3" },
        "size": { "$ref": "#/$defs/vec3" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "path", "parent", "children", "position", "rotation", "envelope"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["group", "part"] },
        "label": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$",
          "description": "Slash-joined ids from the root: the stable hierarchy key."
        },
        "parent": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "children": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "position": { "$ref": "#/$defs/vec3", "description": "Authored origin in the parent frame, joints at 0." },
        "rotation": { "$ref": "#/$defs/vec3", "description": "Authored XYZ Euler degrees, joints at 0." },
        "shape": {
          "type": "object",
          "description": "Parts only: the concept primitive, verbatim from the scene.",
          "required": ["type"],
          "properties": { "type": { "enum": ["box", "cylinder", "sphere", "capsule"] } }
        },
        "envelope": { "$ref": "#/$defs/envelope" }
      },
      "if": { "properties": { "kind": { "const": "part" } } },
      "then": { "required": ["shape"], "properties": { "children": { "maxItems": 0 } } },
      "else": { "not": { "required": ["shape"] } }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type", "parent", "child", "axis", "origin", "min", "max", "nominal", "unit"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["revolute", "prismatic"] },
        "parent": { "$ref": "#/$defs/id" },
        "child": { "$ref": "#/$defs/id" },
        "axis": { "$ref": "#/$defs/vec3", "description": "Unit vector in the parent frame." },
        "origin": { "$ref": "#/$defs/vec3", "description": "Joint origin in the parent frame, mm." },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "nominal": { "type": "number" },
        "unit": { "enum": ["deg", "mm"] }
      },
      "if": { "properties": { "type": { "const": "revolute" } } },
      "then": { "properties": { "unit": { "const": "deg" } } },
      "else": { "properties": { "unit": { "const": "mm" } } }
    }
  }
}
