{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/recheck.schema.json",
  "title": "CAD staged recheck stamp",
  "type": "object",
  "additionalProperties": false,
  "required": ["tree_hash", "stage", "checks", "passed", "timestamp", "tool_versions"],
  "properties": {
    "tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {"$ref": "product.schema.json#/$defs/stage"},
    "checks": {},
    "passed": {"type": "boolean"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
