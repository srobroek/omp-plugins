{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/bom-row.schema.json",
  "title": "EBOM row",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "PN", "rev", "qty", "title", "material", "process", "make_buy", "supplier", "mass"],
  "properties": {
    "level": {"type": "integer", "minimum": 1},
    "PN": {"type": "string", "pattern": "^[A-Z]{2,5}-[0-9]{4}$"},
    "rev": {"type": "string", "pattern": "^(X[1-9][0-9]*|[A-HJ-NPRTUVWY])$"},
    "qty": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "material": {"type": "string", "minLength": 1},
    "process": {"type": "string", "enum": ["fdm", "cnc", "purchased"]},
    "make_buy": {"type": "string", "enum": ["make", "buy"]},
    "supplier": {"type": ["string", "null"]},
    "mass": {"type": ["number", "null"], "exclusiveMinimum": 0}
  }
}
