{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/bom-row.schema.json",
  "title": "EBOM row",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "PN", "rev", "qty", "title", "material", "process", "make_buy", "supplier", "mass"],
  "properties": {
    "level": {"type": "integer", "minimum": 0},
    "PN": {"type": "string", "pattern": "^[A-Z]{2,5}-[0-9]{4}$"},
    "rev": {"type": ["string", "null"], "pattern": "^(X[1-9][0-9]*|[A-HJ-NPRTUVWY])?$"},
    "qty": {"type": "integer", "minimum": 1},
    "title": {"type": ["string", "null"]},
    "material": {"type": ["string", "null"]},
    "process": {"type": ["string", "null"], "enum": ["fdm", "cnc", "purchased", null]},
    "make_buy": {"type": ["string", "null"], "enum": ["make", "buy", null]},
    "supplier": {"type": ["string", "null"]},
    "mass": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "unit": {"description": "what qty counts; the BOM counts STEP instances", "enum": ["pcs"]},
    "designation": {"type": ["string", "null"]},
    "manufacturer": {"type": ["string", "null"]},
    "manufacturer_part_number": {"type": ["string", "null"]},
    "supplier_part_number": {"type": ["string", "null"]},
    "specification_ref": {"type": ["string", "null"]},
    "specification_rev": {"type": ["string", "null"]}
  }
}
