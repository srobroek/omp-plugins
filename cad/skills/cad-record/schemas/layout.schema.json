{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/layout.schema.json",
  "title": "CAD hw/ layout (cad-record layout.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tokens", "legend", "entries", "exceptions", "rules", "classes", "findings", "manufacturing"],
  "properties": {
    "schema_version": {"const": 1},
    "tokens": {
      "description": "Placeholders a path template may use as {TOKEN}; ** spans one or more names (none when it starts a template's middle)",
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Z][A-Z_]*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["pattern", "example", "meaning"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1, "format": "regex"},
          "example": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1}
        }
      }
    },
    "legend": {
      "type": "object", "additionalProperties": false, "required": ["kind", "mutability", "role"],
      "properties": {
        "kind": {"$ref": "#/$defs/glossary", "propertyNames": {"$ref": "#/$defs/kind"}},
        "mutability": {"$ref": "#/$defs/glossary", "propertyNames": {"$ref": "#/$defs/mutability"}},
        "role": {"$ref": "#/$defs/glossary", "propertyNames": {"$ref": "#/$defs/role"}}
      }
    },
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "classes": {
      "description": "Stray classes by file suffix; the last class, with no suffixes, takes every other file",
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/class"}
    },
    "findings": {
      "description": "Every finding code the layout check emits; message and action are templates for codes no rule, class or exception words",
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^layout\\.[a-z_]+$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["severity", "meaning"],
        "properties": {
          "severity": {"description": "stage: warning before design_freeze, error at or after it or once a frozen anchor exists", "enum": ["stage", "warning", "error"]},
          "meaning": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1}
        }
      }
    },
    "manufacturing": {
      "type": "object", "additionalProperties": false,
      "required": ["custom_made", "outputs", "formats", "mesh", "same_state_volume_rel_tolerance"],
      "properties": {
        "custom_made": {
          "description": "A part is custom-made when any condition holds",
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["field", "equals"],
            "properties": {"field": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"}, "equals": {"type": "string", "minLength": 1}}
          }
        },
        "outputs": {
          "type": "object", "additionalProperties": false, "required": ["fdm", "cnc", "purchased"],
          "properties": {
            "fdm": {"$ref": "#/$defs/output_files"}, "cnc": {"$ref": "#/$defs/output_files"}, "purchased": {"$ref": "#/$defs/output_files"}
          }
        },
        "formats": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "mesh": {
          "type": "object", "additionalProperties": false, "required": ["linear_deflection_mm", "angular_deflection_rad"],
          "properties": {
            "linear_deflection_mm": {"type": "number", "exclusiveMinimum": 0},
            "angular_deflection_rad": {"type": "number", "exclusiveMinimum": 0, "maximum": 3.141592653589793}
          }
        },
        "same_state_volume_rel_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  },
  "$defs": {
    "kind": {"enum": ["record", "generated", "scratch"]},
    "mutability": {"enum": ["controlled", "regenerated", "append_only", "free", "immutable", "pointer", "scratch"]},
    "role": {"enum": ["source", "data", "document", "evidence", "review", "definition", "manufacture", "manifest", "snapshot", "navigation", "control", "scratch"]},
    "glossary": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "template": {
      "description": "Project-relative path of names and {TOKEN} placeholders",
      "type": "string", "pattern": "^(hw|\\.cad-work)(/[^/]+)*$"
    },
    "relative": {"type": "string", "pattern": "^[^/]+(/[^/]+)*$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["name", "role"],
      "properties": {
        "name": {"$ref": "#/$defs/relative"},
        "role": {"$ref": "#/$defs/role"},
        "optional": {"type": "boolean"},
        "excludes": {"description": "stray classes this name never accepts", "type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "entry": {
      "description": "A file entry has a role; a directory entry lists the files it holds",
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "kind", "writer", "stage", "mutability", "meaning"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)*$"},
        "path": {"$ref": "#/$defs/template"},
        "kind": {"$ref": "#/$defs/kind"},
        "role": {"$ref": "#/$defs/role"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "writer": {"type": "string", "minLength": 1},
        "stage": {"description": "the workflow stage the path first appears at", "anyOf": [{"$ref": "product.schema.json#/$defs/stage"}, {"const": "any"}]},
        "mutability": {"$ref": "#/$defs/mutability"},
        "manifest": {"description": "the manifest.json format that seals the directory", "enum": ["version", "bundle", "release"]},
        "meaning": {"type": "string", "minLength": 1}
      },
      "oneOf": [{"required": ["role"], "not": {"required": ["files"]}}, {"required": ["files"], "not": {"required": ["role"]}}],
      "dependentRequired": {"manifest": ["files"]}
    },
    "exception": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "kind", "writer", "action"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)*$"},
        "path": {"$ref": "#/$defs/template"},
        "directory": {"type": "boolean"},
        "kind": {"description": "transient and metadata are reported; vcs is accepted silently", "enum": ["transient", "metadata", "vcs"]},
        "writer": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["code", "canonical", "message", "action"],
      "properties": {
        "code": {"type": "string", "pattern": "^layout\\.[a-z_]+$"},
        "match": {"$ref": "#/$defs/template"},
        "referenced_by": {"type": "string", "minLength": 1},
        "directory": {"type": "boolean"},
        "canonical": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      },
      "oneOf": [{"required": ["match"]}, {"required": ["referenced_by"]}]
    },
    "class": {
      "type": "object", "additionalProperties": false, "required": ["class", "suffixes", "canonical", "message", "action"],
      "properties": {
        "class": {"type": "string", "pattern": "^[a-z]+$"},
        "suffixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
        "canonical": {"type": "string", "minLength": 1},
        "file_by_suffix": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "message": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "output_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
