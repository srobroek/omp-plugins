{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/requirements.schema.json",
  "title": "CAD requirements record",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "rationale", "source", "priority", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"},
          "text": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["must", "should", "could", "MUST", "SHOULD", "COULD"]},
          "verification": {
            "type": "object", "additionalProperties": false,
            "required": ["method", "criteria"],
            "properties": {
              "method": {"type": "string", "enum": ["I", "A", "D", "T"]},
              "criteria": {"type": "string", "minLength": 1}
            }
          },
          "visibility": {
            "description": "Show-the-motion checks: from view, rendering only the window and target parts at the nominal pose, at least min_visible_fraction (default 0.5) of the targets' projected area is visible. Only transparency: transparent window parts are see-through",
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["view", "window", "targets"],
              "properties": {
                "view": {
                  "description": "A cad-render view: iso, front, side, or a dir-X-Y-Z direction in assembly coordinates",
                  "type": "string",
                  "pattern": "^(?:iso|front|side|dir-[pm](?:0|[1-9][0-9]{0,5})(?:d[0-9]{0,5}[1-9])?-[pm](?:0|[1-9][0-9]{0,5})(?:d[0-9]{0,5}[1-9])?-[pm](?:0|[1-9][0-9]{0,5})(?:d[0-9]{0,5}[1-9])?)$",
                  "not": {"description": "a direction needs a non-zero component", "pattern": "^dir-[pm]0-[pm]0-[pm]0$"}
                },
                "window": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "assembly.schema.json#/$defs/part_ref"}},
                "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "assembly.schema.json#/$defs/part_ref"}},
                "min_visible_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    }
  }
}
