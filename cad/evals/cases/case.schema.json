{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srobroek/omp-plugins/cad/evals/cases/case.schema.json",
  "title": "cad eval case",
  "description": "One eval case. Everything here is visible to the model under test except `truth`, which names a directory under cad/evals/ that only graders read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tier",
    "tags",
    "kernel",
    "prompt",
    "gate_answers",
    "seed",
    "deliverables",
    "truth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "tier": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ],
      "description": "T1 single part, T2 subassembly, T3 full product flow."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "tags[0] is the ratchet split stratum."
    },
    "kernel": {
      "enum": [
        "cadquery",
        "build123d"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "gate_answers": {
      "type": "array",
      "description": "Scripted user replies. After each turn the first entry whose `when` regex matches the final assistant text, and has uses left, is sent as the next turn.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "reply"
        ],
        "properties": {
          "when": {
            "type": "string"
          },
          "reply": {
            "type": "string"
          },
          "max_uses": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        }
      }
    },
    "seed": {
      "type": "string",
      "description": "Directory under cases/seeds/ copied into the fresh sandbox."
    },
    "deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pn",
        "step"
      ],
      "properties": {
        "pn": {
          "type": "string",
          "pattern": "^[A-Z]{2,5}-\\d{4}$"
        },
        "step": {
          "type": "string",
          "description": "Legacy sandbox-relative STEP path, used only when hw/versions/latest.json (the cad-model build index) is absent."
        },
        "record": {
          "type": "string",
          "default": "hw"
        },
        "collect": {
          "type": "string",
          "default": "hw",
          "description": "Sandbox-relative directory kept as the trial artifact for judging."
        }
      }
    },
    "truth": {
      "type": "string",
      "pattern": "^truth/[a-z0-9-]+$"
    }
  }
}
